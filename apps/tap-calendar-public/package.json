{
  "name": "@tap-examples/tap-calendar-public",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "type": "module",
  "scripts": {
    "build": "rsbuild build",
    "build:production": "rsbuild build && wrangler deploy --dry-run --env production --outdir worker-dist",
    "deploy:dry-run": "wrangler deploy --dry-run --env production --outdir worker-dist",
    "deploy:production": "pnpm run build && wrangler deploy --env production",
    "dev": "rsbuild dev",
    "preview": "rsbuild preview",
    "test": "rstest run",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types --env production --strict-vars=false",
    "types:check": "wrangler types --env production --strict-vars=false --check"
  },
  "dependencies": {
    "@theaiplatform/miniapp-sdk": "0.7.0",
    "@vvo/tzdb": "6.198.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@rsbuild/core": "^2.1.5",
    "@rsbuild/plugin-react": "2.1.0",
    "@rstest/core": "0.11.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^6.0.3",
    "wrangler": "4.123.0"
  }
}
