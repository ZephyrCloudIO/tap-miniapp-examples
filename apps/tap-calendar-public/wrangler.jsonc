{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tap-calendar-public",
  "account_id": "b848db7e2edd56dee8ffcc39c18612a5",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-14",
  "workers_dev": false,
  "preview_urls": false,
  "env": {
    "production": {
      "name": "tap-calendar-public-production",
      "routes": [
        {
          "pattern": "cal.with-tap.ai",
          "custom_domain": true
        }
      ],
      "services": [
        {
          "binding": "CALENDAR_GATEWAY",
          "service": "tap-calendar-gateway-production"
        }
      ],
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"]
      },
      "observability": {
        "enabled": true,
        "logs": { "head_sampling_rate": 1 },
        "traces": { "enabled": true, "head_sampling_rate": 1 }
      }
    }
  }
}
