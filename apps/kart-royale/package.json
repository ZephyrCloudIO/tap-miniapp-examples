{
  "name": "@tap-examples/kart-royale",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./track-math": "./src/world/TrackMath.ts",
    "./item-tables": "./src/game/ItemTables.ts"
  },
  "scripts": {
    "dev": "rsbuild dev",
    "preview": "rsbuild preview",
    "build": "pnpm build:preview && pnpm build:miniapp",
    "build:watch": "rslib build --watch",
    "build:preview": "rsbuild build",
    "build:miniapp": "pnpm build:miniapp:desktop && pnpm build:miniapp:quickjs && pnpm build:miniapp:assemble && pnpm verify:package",
    "build:miniapp:desktop": "cross-env TAP_PACKAGE_TARGET=desktop rslib build",
    "build:miniapp:quickjs": "cross-env TAP_PACKAGE_TARGET=quickjs rslib build",
    "build:lifecycle-target": "rslib build",
    "build:miniapp:assemble": "node scripts/assemble-package.mjs",
    "verify:package": "node ../../scripts/verify-built-package.mjs dist",
    "typecheck": "tsc --noEmit",
    "typecheck:tap": "tsc --project ./tsconfig.tap-test.json --noEmit",
    "test": "rstest run && node --test src/*.test.mjs",
    "test:tap": "rstest run --config ./rstest.tap.config.ts",
    "test:tap:list": "rstest list --config ./rstest.tap.config.ts"
  },
  "dependencies": {
    "@theaiplatform/miniapp-sdk": "0.7.0",
    "@tap-examples/kart-royale-protocol": "workspace:*",
    "n8ao": "^2.0.0",
    "postprocessing": "^6.39.3",
    "simplex-noise": "^4.0.3",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@module-federation/rsbuild-plugin": "2.8.1",
    "@rsbuild/core": "^2.1.5",
    "@rslib/core": "^0.23.2",
    "@rstest/core": "0.11.5",
    "@rstest/playwright": "0.11.5",
    "@types/node": "^24.13.2",
    "@types/three": "^0.185.1",
    "playwright": "^1.61.0",
    "puppeteer": "^25.3.0",
    "typescript": "^6.0.3",
    "zephyr-rsbuild-plugin": "1.2.1"
  }
}
