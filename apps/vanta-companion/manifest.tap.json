{
  "$schema": "./node_modules/@theaiplatform/miniapp-sdk/config-schema.json",
  "descriptorVersion": 1,
  "package": {
    "packageId": "tap_pkg_examples_vanta_companion_0001",
    "publisherId": "publisher_theaiplatform_examples",
    "organizationId": "organization_theaiplatform",
    "namespace": "examples-vanta-companion",
    "slug": "vanta-companion"
  },
  "release": {
    "releaseId": "tap_pkg_examples_vanta_companion_0001@0.1.0",
    "version": "0.1.0",
    "contentDigest": "pending"
  },
  "presentation": {
    "name": "Vanta Companion",
    "description": "A governed SOC 2 coordination workspace that displays only authorized source data.",
    "iconAssets": ["assets/vanta-companion.svg"],
    "assets": [
      {
        "role": "app-icon",
        "mediaType": "image/svg+xml",
        "path": "assets/vanta-companion.svg",
        "integrity": "pending",
        "sizes": ["any"],
        "theme": "any"
      }
    ]
  },
  "compatibility": {
    "tapSdk": "0.7.0",
    "tapHost": ">=0.1.0"
  },
  "targets": {
    "desktop": {
      "remoteName": "tap_vanta_companion_desktop",
      "remoteEntry": "remoteEntry.mjs",
      "remoteEntryIntegrity": "pending",
      "manifest": "mf-manifest.json",
      "manifestIntegrity": "pending",
      "assetLock": "tap.package.lock.json",
      "assetLockIntegrity": "pending",
      "libraryType": "module",
      "exposes": {
        "./tap/lifecycle": { "integrity": "pending", "runtime": "webview" },
        "./ui/desktop": { "integrity": "pending", "runtime": "webview" }
      }
    }
  },
  "contributions": [
    {
      "kind": "ui.surface",
      "id": "vanta-companion",
      "apiVersion": 1,
      "targets": {
        "desktop": { "expose": "./ui/desktop", "runtime": "webview" }
      },
      "authorization": {
        "allOf": ["vanta-companion.view"],
        "onDemand": [
          "vanta-companion.coordinate",
          "vanta-companion.analyze",
          "channels.create",
          "channels.send-message",
          "channels.manage-specialists",
          "workflows.list",
          "workflows.invoke",
          "specialists.invoke",
          "credentials.read",
          "credentials.use",
          "network.request"
        ],
        "effects": [
          { "kind": "storage", "resources": ["vanta-companion"] },
          {
            "kind": "external-network",
            "resources": ["https://api.vanta.com", "https://*"]
          },
          {
            "kind": "credentials",
            "resources": ["http"]
          },
          {
            "kind": "host-api",
            "resources": [
              "tap.channels:create",
              "tap.channels:send-message",
              "tap.channels:manage-specialists",
              "tap.workflows:list",
              "tap.workflows:invoke",
              "tap.specialists:invoke"
            ]
          },
          {
            "kind": "mcp.oauth",
            "resources": [
              "https://mcp.vanta.com/mcp",
              "https://mcp.eu.vanta.com/mcp",
              "https://mcp.aus.vanta.com/mcp"
            ]
          }
        ]
      },
      "publishes": [
        "vanta-companion.surface.mounted",
        "vanta-companion.surface.unmounted"
      ],
      "lifecycleScope": "mount",
      "options": {
        "displayName": "Vanta Companion",
        "description": "Coordinate a SOC 2 program without weakening source-system governance.",
        "placement": "workspace-left",
        "scope": "workspace",
        "instancePolicy": "per-workspace",
        "persistence": "retained",
        "iconAssets": ["assets/vanta-companion.svg"]
      }
    },
    {
      "kind": "miniapp",
      "id": "vanta-companion-app",
      "apiVersion": 1,
      "options": { "contributionIds": ["vanta-companion"] }
    },
    {
      "kind": "specialist",
      "id": "vanta-soc2-companion-us",
      "apiVersion": 1,
      "targets": {
        "desktop": { "runtime": "host-declarative" }
      },
      "lifecycleScope": "installation",
      "options": {
        "manifest": "specialists/vanta-soc2-companion-us/0.1.0.json"
      }
    },
    {
      "kind": "specialist",
      "id": "vanta-soc2-companion-eu",
      "apiVersion": 1,
      "targets": {
        "desktop": { "runtime": "host-declarative" }
      },
      "lifecycleScope": "installation",
      "options": {
        "manifest": "specialists/vanta-soc2-companion-eu/0.1.0.json"
      }
    },
    {
      "kind": "specialist",
      "id": "vanta-soc2-companion-aus",
      "apiVersion": 1,
      "targets": {
        "desktop": { "runtime": "host-declarative" }
      },
      "lifecycleScope": "installation",
      "options": {
        "manifest": "specialists/vanta-soc2-companion-aus/0.1.0.json"
      }
    },
    {
      "kind": "permission.catalog",
      "id": "vanta-companion-permissions",
      "apiVersion": 1,
      "options": {
        "actions": [
          {
            "id": "vanta-companion.view",
            "resource": "tap.vanta-companion:view",
            "scopes": ["workspace"],
            "directActors": ["human"],
            "delegatedActors": ["specialist"],
            "autonomyCeiling": "listen",
            "consent": "none",
            "risk": "read"
          },
          {
            "id": "vanta-companion.coordinate",
            "resource": "tap.vanta-companion:coordinate",
            "scopes": ["workspace", "channel"],
            "directActors": ["human"],
            "delegatedActors": ["specialist"],
            "autonomyCeiling": "do",
            "consent": "reusable",
            "risk": "write"
          },
          {
            "id": "vanta-companion.analyze",
            "resource": "tap.specialist:vanta-soc2-companion",
            "scopes": ["workspace", "channel", "project"],
            "directActors": ["human"],
            "delegatedActors": ["specialist"],
            "autonomyCeiling": "plan",
            "consent": "none",
            "risk": "read"
          },
          {
            "id": "channels.create",
            "resource": "tap.channels:create",
            "scopes": ["workspace"],
            "directActors": ["human"],
            "delegatedActors": [],
            "autonomyCeiling": "do",
            "consent": "reusable",
            "risk": "write"
          },
          {
            "id": "channels.send-message",
            "resource": "tap.channels:send-message",
            "scopes": ["workspace", "channel"],
            "directActors": ["human"],
            "delegatedActors": [],
            "autonomyCeiling": "do",
            "consent": "reusable",
            "risk": "write"
          },
          {
            "id": "channels.manage-specialists",
            "resource": "tap.channels:manage-specialists",
            "scopes": ["workspace", "channel"],
            "directActors": ["human"],
            "delegatedActors": [],
            "autonomyCeiling": "do",
            "consent": "reusable",
            "risk": "write"
          },
          {
            "id": "workflows.list",
            "resource": "tap.workflows:list",
            "scopes": ["workspace"],
            "directActors": ["human"],
            "delegatedActors": [],
            "autonomyCeiling": "listen",
            "consent": "none",
            "risk": "read"
          },
          {
            "id": "workflows.invoke",
            "resource": "tap.workflows:invoke",
            "scopes": ["workspace"],
            "directActors": ["human"],
            "delegatedActors": [],
            "autonomyCeiling": "do",
            "consent": "reusable",
            "risk": "consequential"
          },
          {
            "id": "specialists.invoke",
            "resource": "tap.specialists:invoke",
            "scopes": ["workspace", "channel", "project"],
            "directActors": ["human"],
            "delegatedActors": [],
            "autonomyCeiling": "do",
            "consent": "reusable",
            "risk": "consequential"
          },
          {
            "id": "credentials.read",
            "resource": "tap.credentials:read",
            "scopes": ["workspace"],
            "directActors": ["human"],
            "delegatedActors": [],
            "autonomyCeiling": "listen",
            "consent": "none",
            "risk": "read"
          },
          {
            "id": "credentials.use",
            "resource": "tap.credentials:use",
            "scopes": ["workspace"],
            "directActors": ["human"],
            "delegatedActors": [],
            "autonomyCeiling": "do",
            "consent": "reusable",
            "risk": "consequential"
          },
          {
            "id": "network.request",
            "resource": "tap.network:request",
            "scopes": ["workspace"],
            "directActors": ["human"],
            "delegatedActors": [],
            "autonomyCeiling": "do",
            "consent": "reusable",
            "risk": "consequential"
          }
        ],
        "levels": [
          {
            "id": "compliance-viewer",
            "actions": ["vanta-companion.view"],
            "assignableTo": ["human", "specialist"]
          },
          {
            "id": "compliance-operator",
            "actions": [
              "vanta-companion.view",
              "vanta-companion.analyze",
              "vanta-companion.coordinate",
              "channels.create",
              "channels.send-message",
              "channels.manage-specialists",
              "workflows.list",
              "workflows.invoke",
              "specialists.invoke",
              "credentials.read",
              "credentials.use",
              "network.request"
            ],
            "assignableTo": ["human"]
          },
          {
            "id": "compliance-lead",
            "actions": [
              "vanta-companion.view",
              "vanta-companion.analyze",
              "vanta-companion.coordinate",
              "channels.create",
              "channels.send-message",
              "channels.manage-specialists",
              "workflows.list",
              "workflows.invoke",
              "specialists.invoke",
              "credentials.read",
              "credentials.use",
              "network.request"
            ],
            "assignableTo": ["human"]
          }
        ],
        "roleRecommendations": [
          {
            "actor": "human",
            "workspaceRole": "member",
            "level": "compliance-viewer"
          }
        ]
      }
    }
  ],
  "events": {
    "publishes": [
      {
        "name": "vanta-companion.surface.mounted",
        "schema": "urn:tap:vanta-companion:surface-event:1",
        "schemaVersion": 1,
        "visibility": "workspace",
        "delivery": "ephemeral"
      },
      {
        "name": "vanta-companion.surface.unmounted",
        "schema": "urn:tap:vanta-companion:surface-event:1",
        "schemaVersion": 1,
        "visibility": "workspace",
        "delivery": "ephemeral"
      }
    ]
  },
  "lifecycle": {
    "checkpoint": "retained",
    "lifecycleExpose": "./tap/lifecycle"
  }
}
