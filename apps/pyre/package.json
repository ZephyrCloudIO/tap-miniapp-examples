{
  "name": "@tap-examples/pyre",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "rsbuild dev",
    "preview": "rsbuild preview",
    "build": "pnpm build:preview && pnpm build:miniapp",
    "build:watch": "rslib build --watch",
    "build:preview": "rsbuild build",
    "build:miniapp": "pnpm build:miniapp:desktop && pnpm build:miniapp:quickjs && pnpm build:miniapp:assemble && pnpm verify:package",
    "build:miniapp:desktop": "TAP_PACKAGE_TARGET=desktop rslib build",
    "build:miniapp:quickjs": "TAP_PACKAGE_TARGET=quickjs rslib build",
    "build:miniapp:assemble": "node scripts/assemble-package.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:tap": "tsc --project ./tsconfig.tap-test.json --noEmit",
    "test": "rstest run",
    "test:tap": "rstest run --config ./rstest.tap.config.ts",
    "test:tap:list": "rstest list --config ./rstest.tap.config.ts",
    "validate:manifest": "node scripts/validate-manifest.mjs",
    "verify:package": "node ../../scripts/verify-built-package.mjs .tap-package && node scripts/verify-react-runtime.mjs",
    "verify:react-runtime": "node scripts/verify-react-runtime.mjs"
  },
  "dependencies": {
    "@theaiplatform/miniapp-sdk": "0.5.3",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@module-federation/rsbuild-plugin": "2.8.1",
    "@rsbuild/core": "^2.1.5",
    "@rsbuild/plugin-react": "2.1.0",
    "@rslib/core": "^0.23.2",
    "@rstest/core": "0.11.5",
    "@rstest/playwright": "0.11.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "ajv": "^8.20.0",
    "playwright": "^1.61.0",
    "typescript": "^6.0.3"
  }
}
