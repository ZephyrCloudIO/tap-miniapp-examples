{
  "$schema": "./node_modules/@theaiplatform/miniapp-sdk/config-schema.json",
  "descriptorVersion": 1,
  "package": {
    "packageId": "tap_pkg_examples_pyre_0001",
    "publisherId": "publisher_theaiplatform_examples",
    "organizationId": "organization_theaiplatform",
    "namespace": "examples-pyre",
    "slug": "pyre"
  },
  "release": {
    "releaseId": "tap_pkg_examples_pyre_0001@0.1.0",
    "version": "0.1.0",
    "contentDigest": "pending"
  },
  "presentation": {
    "name": "Pyre",
    "description": "Evidence-driven, blameless incident investigations and reviewable reports.",
    "categories": ["business", "data-and-analytics"],
    "iconAssets": []
  },
  "compatibility": {
    "tapSdk": "0.4.2",
    "tapHost": ">=0.1.0"
  },
  "targets": {
    "desktop": {
      "remoteName": "tap_pyre_desktop",
      "remoteEntry": "remoteEntry.mjs",
      "remoteEntryIntegrity": "pending",
      "manifest": "mf-manifest.json",
      "manifestIntegrity": "pending",
      "assetLock": "tap.package.lock.json",
      "assetLockIntegrity": "pending",
      "libraryType": "module",
      "exposes": {
        "./tap/lifecycle": {
          "integrity": "pending",
          "runtime": "webview"
        },
        "./ui/desktop": {
          "integrity": "pending",
          "runtime": "webview"
        },
        "./specialists/pyre": {
          "integrity": "pending",
          "runtime": "webview"
        }
      }
    },
    "quickjs": {
      "remoteName": "tap_pyre_quickjs",
      "remoteEntry": "remoteEntry.mjs",
      "remoteEntryIntegrity": "pending",
      "manifest": "mf-manifest.json",
      "manifestIntegrity": "pending",
      "assetLock": "tap.package.lock.json",
      "assetLockIntegrity": "pending",
      "libraryType": "module",
      "exposes": {
        "./mcp/pyre-mcp": {
          "integrity": "pending",
          "runtime": "quickjs"
        }
      }
    }
  },
  "contributions": [
    {
      "kind": "ui.surface",
      "id": "pyre",
      "apiVersion": 1,
      "targets": {
        "desktop": {
          "expose": "./ui/desktop",
          "runtime": "webview"
        }
      },
      "publishes": [
        "pyre.surface.mounted",
        "pyre.surface.unmounted"
      ],
      "authorization": {
        "allOf": ["pyre.view"],
        "onDemand": [
          "pyre.investigate",
          "pyre.approve",
          "profile.read",
          "credentials.read",
          "credentials.use",
          "network.request",
          "projects.create",
          "projects.update",
          "channels.create",
          "channels.send-message",
          "channels.manage-specialists",
          "specialists.manage",
          "vfs.provision-project-chat",
          "vfs.write",
          "workflows.list",
          "workflows.invoke"
        ],
        "effects": [
          {
            "kind": "storage",
            "resources": [
              "pyre"
            ]
          },
          {
            "kind": "external-network",
            "resources": [
              "https://api.github.com"
            ]
          },
          {
            "kind": "credentials",
            "resources": [
              "http"
            ]
          },
          {
            "kind": "presence",
            "resources": [
              "pyre"
            ]
          },
          {
            "kind": "host-api",
            "resources": [
              "tap.channels:create",
              "tap.channels:send-message",
              "tap.channels:manage-specialists",
              "tap.projects:create",
              "tap.projects:update",
              "tap.specialists:manage",
              "tap.vfs:provision-project-chat",
              "tap.vfs:write",
              "tap.workflows:list",
              "tap.workflows:invoke"
            ]
          }
        ]
      },
      "lifecycleScope": "mount",
      "options": {
        "displayName": "Pyre",
        "description": "Investigate incidents with evidence and governed causal analysis.",
        "placement": "workspace-left",
        "scope": "workspace",
        "instancePolicy": "per-workspace",
        "persistence": "retained"
      }
    },
    {
      "kind": "specialist",
      "id": "pyre-investigation-specialist",
      "apiVersion": 1,
      "targets": {
        "desktop": {
          "expose": "./specialists/pyre",
          "runtime": "webview"
        }
      },
      "authorization": {
        "allOf": ["pyre.investigate"]
      },
      "lifecycleScope": "contribution",
      "options": {
        "effects": [
          {"kind":"host-api","resources":["tap.channels","tap.storage","tap.vfs","tap.workflows"]}
        ]
      }
    },
    {
      "kind": "mcp.server",
      "id": "pyre-mcp",
      "apiVersion": 1,
      "targets": {
        "quickjs": {
          "expose": "./mcp/pyre-mcp",
          "runtime": "quickjs"
        }
      },
      "authorization": {
        "allOf": ["pyre.view"],
        "effects": [
          {"kind":"storage","resources":["pyre"]}
        ]
      },
      "lifecycleScope": "contribution",
      "options": {
        "protocolVersion": "2025-03-26",
        "implementation": {
          "type": "package-runtime"
        },
        "consumerPolicy": {
          "contributionIds": ["pyre-investigation-specialist"],
          "externalConsumers": ["selected-specialists"]
        }
      }
    },
    {
      "kind": "mcp.tool",
      "id": "pyre-list-investigations",
      "apiVersion": 1,
      "authorization": {
        "allOf": ["pyre.view"],
        "effects": [
          {"kind":"storage","resources":["pyre"]}
        ]
      },
      "lifecycleScope": "contribution",
      "options": {
        "serverContributionId": "pyre-mcp",
        "toolName": "list_investigations",
        "timeoutMs": 10000,
        "effects": [
          {"kind":"storage","resources":["pyre"]}
        ],
        "storageReads": [
          {"namespace":"pyre","keyTemplate":"investigations/v2"},
          {"namespace":"pyre","keyTemplate":"investigations/v1"}
        ]
      }
    },
    {
      "kind": "mcp.tool",
      "id": "pyre-get-investigation",
      "apiVersion": 1,
      "authorization": {
        "allOf": ["pyre.view"],
        "effects": [
          {"kind":"storage","resources":["pyre"]}
        ]
      },
      "lifecycleScope": "contribution",
      "options": {
        "serverContributionId": "pyre-mcp",
        "toolName": "get_investigation",
        "timeoutMs": 10000,
        "effects": [
          {"kind":"storage","resources":["pyre"]}
        ],
        "storageReads": [
          {"namespace":"pyre","keyTemplate":"investigations/v2"},
          {"namespace":"pyre","keyTemplate":"investigations/v1"}
        ]
      }
    },
    {
      "kind": "miniapp",
      "id": "pyre-app",
      "apiVersion": 1,
      "options": {
        "contributionIds": [
          "pyre",
          "pyre-investigation-specialist",
          "pyre-mcp",
          "pyre-list-investigations",
          "pyre-get-investigation"
        ]
      }
    },
