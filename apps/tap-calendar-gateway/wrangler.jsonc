{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tap-calendar-gateway",
  "account_id": "b848db7e2edd56dee8ffcc39c18612a5",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "ALLOWED_ORIGINS": "https://cal.with-tap.ai,http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://tauri.localhost",
    "AUTH0_DOMAIN": "auth.zephyr-cloud.io",
    "AUTH0_AUDIENCE": "https://api.zephyr-cloud.io",
    "PUBLIC_BASE_URL": "",
    "PUBLIC_BOOKING_BASE_URL": "https://cal.with-tap.ai"
  },
  "services": [
    {
      "binding": "AUTHZ_API",
      "service": "ze-agency-authz-api-production",
      "entrypoint": "AuthzRpc"
    }
  ],
  "ratelimits": [
    {
      "name": "PUBLIC_AVAILABILITY_RATE_LIMITER",
      "namespace_id": "41001",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "PUBLIC_BOOKING_RATE_LIMITER",
      "namespace_id": "41002",
      "simple": { "limit": 12, "period": 60 }
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "CALENDAR_DB",
      "database_name": "tap-calendar-gateway-local",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 1 }
  },
  "env": {
    "production": {
      "account_id": "b848db7e2edd56dee8ffcc39c18612a5",
      "name": "tap-calendar-gateway-production",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "calendar-api.theaiplatform.app",
          "custom_domain": true
        }
      ],
      "vars": {
        "ALLOWED_ORIGINS": "https://cal.with-tap.ai,http://tauri.localhost",
        "AUTH0_DOMAIN": "auth.theaiplatform.app",
        "AUTH0_AUDIENCE": "https://api.theaiplatform.app",
        "PUBLIC_BASE_URL": "https://calendar-api.theaiplatform.app",
        "PUBLIC_BOOKING_BASE_URL": "https://cal.with-tap.ai",
        "PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAESPERDaCkgFvRr5",
        "PUBLIC_BOOKING_EMAIL_FROM": "bookings@with-tap.ai",
        "PUBLIC_BOOKING_EMAIL_FROM_NAME": "TAP Calendar"
      },
      "services": [
        {
          "binding": "AUTHZ_API",
          "service": "ze-agency-authz-api-production",
          "entrypoint": "AuthzRpc"
        }
      ],
      "ratelimits": [
        {
          "name": "PUBLIC_AVAILABILITY_RATE_LIMITER",
          "namespace_id": "41001",
          "simple": { "limit": 120, "period": 60 }
        },
        {
          "name": "PUBLIC_BOOKING_RATE_LIMITER",
          "namespace_id": "41002",
          "simple": { "limit": 12, "period": 60 }
        },
        {
          "name": "PUBLIC_MANAGEMENT_RATE_LIMITER",
          "namespace_id": "41003",
          "simple": { "limit": 30, "period": 60 }
        }
      ],
      "triggers": {
        "crons": ["*/5 * * * *"]
      },
      "d1_databases": [
        {
          "binding": "CALENDAR_DB",
          "database_name": "tap-calendar-gateway-production",
          "database_id": "3c6d3651-17db-4215-b25f-b1c00f403cc1",
          "migrations_dir": "migrations"
        }
      ],
      "send_email": [
        {
          "name": "EMAIL",
          "allowed_sender_addresses": ["bookings@with-tap.ai"]
        }
      ],
      "observability": {
        "enabled": true,
        "logs": { "head_sampling_rate": 1 },
        "traces": { "enabled": true, "head_sampling_rate": 1 }
      }
    }
  }
}
