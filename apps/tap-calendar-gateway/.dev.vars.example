# OAuth is optional for the local connector. Add these values to enable the
# corresponding real provider authorization button in TAP Calendar.
TOKEN_ENCRYPTION_KEY=replace_with_base64_encoded_32_random_bytes
GOOGLE_CLIENT_ID=replace_with_google_oauth_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_oauth_client_secret
MICROSOFT_CLIENT_ID=replace_with_microsoft_application_client_id
MICROSOFT_CLIENT_SECRET=replace_with_microsoft_application_client_secret

# Public booking security. Use distinct, randomly generated secrets; never copy
# the Turnstile site key into TURNSTILE_SECRET_KEY. The managed widget/site key
# and its secret are created in the Cloudflare Turnstile dashboard.
PUBLIC_TURNSTILE_SITE_KEY=replace_with_turnstile_site_key
TURNSTILE_SECRET_KEY=replace_with_turnstile_secret_key
PUBLIC_BOOKING_SLOT_SIGNING_KEY=replace_with_at_least_32_random_bytes
PUBLIC_BOOKING_MANAGEMENT_SECRET=replace_with_at_least_32_random_bytes

# Production organizer authentication is configured as Wrangler vars/service
# bindings, not as a second Calendar login. The TAP miniapp supplies the
# host-managed platform session. Override these only for an isolated auth stack.
# AUTH0_DOMAIN=auth.zephyr-cloud.io
# AUTH0_AUDIENCE=https://api.zephyr-cloud.io

# Legacy local-data adoption only. Set this temporarily to the one original
# owner's canonical TAP user id while following README.md, then REMOVE it.
# Never put a customer-specific principal in a distributable package or a
# production Worker configuration.
# LEGACY_OWNER_PRINCIPAL_ID=user_replace_with_canonical_tap_id
