{
  "name": "@tap-examples/tap-calendar-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "jose": "6.2.3"
  },
  "scripts": {
    "build": "wrangler deploy --dry-run --env=\"\" --outdir dist",
    "build:production": "wrangler deploy --dry-run --env production --outdir dist-production",
    "check:startup": "wrangler check startup",
    "check:startup:production": "wrangler check startup --env production",
    "deploy:dry-run": "wrangler deploy --dry-run --env production --outdir dist-production",
    "deploy:production": "wrangler deploy --env production",
    "dev": "wrangler dev --test-scheduled --ip 127.0.0.1 --port 8787 --var LOCAL_DEVELOPMENT:true",
    "migrate:local": "wrangler d1 migrations apply CALENDAR_DB --local",
    "migrate:production": "wrangler d1 migrations apply CALENDAR_DB --remote --env production",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types --strict-vars=false --env-file wrangler.types.env",
    "types:check": "wrangler types --strict-vars=false --env-file wrangler.types.env --check"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.21.3",
    "@types/node": "26.1.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "wrangler": "4.123.0"
  }
}
