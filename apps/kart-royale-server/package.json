{
  "name": "@tap-examples/kart-royale-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --env=\"\" --outdir dist",
    "check:startup": "wrangler check startup",
    "predev": "node scripts/ensure-local-dev-vars.mjs",
    "dev": "wrangler dev --local --var ALLOW_DEV_IDENTITY:true",
    "test": "pnpm test:config && vitest run",
    "test:config": "node --test scripts/secure-config.test.mjs",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types --strict-vars=false",
    "types:check": "wrangler types --strict-vars=false --check"
  },
  "dependencies": {
    "@tap-examples/kart-royale": "workspace:*",
    "@tap-examples/kart-royale-protocol": "workspace:*",
    "jose": "6.2.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.18.6",
    "@types/node": "26.1.1",
    "miniflare": "4.20260714.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "wrangler": "4.112.0"
  }
}
