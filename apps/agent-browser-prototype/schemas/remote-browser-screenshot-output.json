{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tap.local/schemas/agent-browser/remote-browser-screenshot-output.json",
  "title": "Remote Browser screenshot metadata output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sessionHandle",
    "documentRevision",
    "control",
    "telemetryCoverageStartedAt",
    "mediaType",
    "byteLength"
  ],
  "properties": {
    "sessionHandle": { "type": "string", "format": "uuid" },
    "documentRevision": { "type": "integer", "minimum": 1 },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["holder", "participantId", "epoch", "expiresAt"],
      "properties": {
        "holder": { "enum": ["agent", "human"] },
        "participantId": { "type": ["string", "null"], "pattern": "^rp_[0-9a-f]{64}$" },
        "epoch": { "type": "integer", "minimum": 1 },
        "expiresAt": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "telemetryCoverageStartedAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "mediaType": { "const": "image/png" },
    "byteLength": { "type": "integer", "minimum": 1, "maximum": 6291456 }
  }
}
