{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tap.local/schemas/agent-browser/remote-browser-network-output.json",
  "title": "Remote Browser network calls output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items",
    "nextCursor",
    "hasMore",
    "telemetryGap",
    "telemetryCoverageStartedAt"
  ],
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "method",
          "url",
          "resourceType",
          "status",
          "failed",
          "errorText",
          "startedAt",
          "finishedAt"
        ],
        "properties": {
          "method": { "type": ["string", "null"] },
          "url": { "type": ["string", "null"] },
          "resourceType": { "type": ["string", "null"] },
          "status": { "type": ["number", "null"] },
          "failed": { "type": ["boolean", "null"] },
          "errorText": { "type": ["string", "null"] },
          "startedAt": { "type": ["string", "null"], "format": "date-time" },
          "finishedAt": { "type": ["string", "null"], "format": "date-time" }
        }
      }
    },
    "nextCursor": { "type": "integer", "minimum": 0 },
    "hasMore": { "type": "boolean" },
    "telemetryGap": { "type": "boolean" },
    "telemetryCoverageStartedAt": {
      "type": ["string", "null"],
      "format": "date-time"
    }
  }
}
