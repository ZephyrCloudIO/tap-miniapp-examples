{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tap.local/schemas/agent-browser/remote-browser-room-output.json",
  "title": "Remote Browser room output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sessionHandle",
    "state",
    "documentRevision",
    "control",
    "participants"
  ],
  "properties": {
    "sessionHandle": { "type": "string", "format": "uuid" },
    "state": { "enum": ["allocating", "active", "closing", "closed", "failed"] },
    "documentRevision": { "type": "integer", "minimum": 1 },
    "control": { "$ref": "#/$defs/control" },
    "participants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/participant" }
    }
  },
  "$defs": {
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["holder", "participantId", "epoch", "expiresAt"],
      "properties": {
        "holder": { "enum": ["agent", "human"] },
        "participantId": {
          "type": ["string", "null"],
          "pattern": "^rp_[0-9a-f]{64}$"
        },
        "epoch": { "type": "integer", "minimum": 1 },
        "expiresAt": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "participantId",
        "kind",
        "principalId",
        "consumerKind",
        "status",
        "creator",
        "self",
        "joinedAt",
        "lastSeenAt",
        "disconnectedAt"
      ],
      "properties": {
        "participantId": { "type": "string", "pattern": "^rp_[0-9a-f]{64}$" },
        "kind": { "enum": ["agent", "human"] },
        "principalId": { "type": "string", "minLength": 1, "maxLength": 512 },
        "consumerKind": {
          "enum": [
            "package-contribution",
            "specialist",
            "chat",
            "workflow",
            "platform-service"
          ]
        },
        "status": { "enum": ["connected", "disconnected"] },
        "creator": { "type": "boolean" },
        "self": { "type": "boolean" },
        "joinedAt": { "type": "string", "format": "date-time" },
        "lastSeenAt": { "type": "string", "format": "date-time" },
        "disconnectedAt": { "type": ["string", "null"], "format": "date-time" }
      }
    }
  }
}
