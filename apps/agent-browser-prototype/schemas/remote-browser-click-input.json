{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tap.local/schemas/agent-browser/remote-browser-click-input.json",
  "title": "Click Remote Browser element input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sessionHandle",
    "expectedControlEpoch",
    "expectedDocumentRevision"
  ],
  "oneOf": [
    {
      "required": ["elementRef"],
      "not": {
        "anyOf": [
          { "required": ["xRatio"] },
          { "required": ["yRatio"] }
        ]
      }
    },
    {
      "required": ["xRatio", "yRatio"],
      "not": { "required": ["elementRef"] }
    }
  ],
  "properties": {
    "sessionHandle": { "type": "string", "format": "uuid" },
    "elementRef": { "type": "string", "minLength": 1, "maxLength": 128 },
    "xRatio": { "type": "number", "minimum": 0, "maximum": 1 },
    "yRatio": { "type": "number", "minimum": 0, "maximum": 1 },
    "expectedControlEpoch": { "type": "integer", "minimum": 1 },
    "expectedDocumentRevision": { "type": "integer", "minimum": 1 }
  }
}
