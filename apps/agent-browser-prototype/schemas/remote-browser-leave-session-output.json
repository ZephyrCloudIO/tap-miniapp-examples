{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tap.local/schemas/agent-browser/remote-browser-leave-session-output.json",
  "title": "Leave Remote Browser room output",
  "type": "object",
  "additionalProperties": false,
  "required": ["sessionHandle", "participantId", "status", "control"],
  "properties": {
    "sessionHandle": { "type": "string", "format": "uuid" },
    "participantId": { "type": "string", "pattern": "^rp_[0-9a-f]{64}$" },
    "status": { "const": "disconnected" },
    "control": { "$ref": "#/$defs/control" }
  },
  "$defs": {
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["holder", "participantId", "epoch", "expiresAt"],
      "properties": {
        "holder": { "enum": ["agent", "human"] },
        "participantId": {
          "type": ["string", "null"],
          "pattern": "^rp_[0-9a-f]{64}$"
        },
        "epoch": { "type": "integer", "minimum": 1 },
        "expiresAt": { "type": ["string", "null"], "format": "date-time" }
      }
    }
  }
}
