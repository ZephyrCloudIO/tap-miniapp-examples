  "matrix": [
    {
      "id": "pr-radar-desktop-default",
      "profile": "pr-radar-desktop",
      "capabilities": [
        "action:credentials.read",
        "action:credentials.use",
        "action:navigation.open-external",
        "action:network.request",
        "effect:credentials:github",
        "effect:credentials:http",
        "effect:external-navigation:https://github.com",
        "effect:external-network:https://api.github.com",
        "effect:storage:github-notify"
      ],
      "testMatch": [
        "tests/e2e/pr-radar-surface.test.ts",
        "tests/e2e/tap-surface.smoke.test.ts"
      ]
    },
    {
      "id": "pr-radar-desktop-network-denied",
      "profile": "pr-radar-desktop-network-denied",
      "testMatch": [
        "tests/e2e/pr-radar-network-denied.test.ts"
      ],
      "capabilities": [
        "action:network.request",
        "effect:external-network:https://api.github.com"
      ]
    },
    {
      "id": "pr-radar-desktop-credentials-use-denied",
      "profile": "pr-radar-desktop-credentials-use-denied",
      "testMatch": [
        "tests/e2e/pr-radar-credentials-use-denied.test.ts"
      ],
      "capabilities": [
        "action:credentials.use",
        "effect:credentials:github",
        "effect:credentials:http"
      ]
    },
    {
      "id": "pr-radar-desktop-storage-denied",
      "profile": "pr-radar-desktop-storage-denied",
      "testMatch": [
        "tests/e2e/pr-radar-storage-denied.test.ts"
      ],
      "capabilities": [
        "effect:storage:github-notify"
      ]
    },
    {
      "id": "pr-radar-desktop-navigation-denied",
      "profile": "pr-radar-desktop-navigation-denied",
      "testMatch": [
        "tests/e2e/pr-radar-navigation-denied.test.ts"
      ],
      "capabilities": [
        "action:navigation.open-external",
        "effect:external-navigation:https://github.com"
      ]
    }
  ],
  "waivers": [
    {
      "capability": "effect:external-navigation:https://github.com",
      "reason": "The navigation.open-external denial row clicks the app's real pull request link and proves the host refuses the github.com origin. Under all-denied, storage reads fail before any pull request renders, so an all-denied row could only call the host directly and would not exercise PR Radar.",
      "expiresAt": "2027-01-31T00:00:00Z"
    }
  ]
}
