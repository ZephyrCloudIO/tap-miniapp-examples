      "environment": {
        "viewport": {
          "width": 1280,
          "height": 720
        },
        "locale": "en-US",
        "timezone": "UTC",
        "theme": "dark",
        "reducedMotion": true,
        "seed": 3,
        "fixedNow": "2026-01-01T00:00:00Z"
      }
    },
    "pr-radar-desktop-storage-denied": {
      "surface": "github-notify-dashboard",
      "target": "desktop",
      "mode": "surface",
      "nativeServices": false,
      "credentialSlots": [],
      "artifacts": {
        "trace": "failure-only",
        "screenshots": "failure-only"
      },
      "permissionScenario": "deny:storage.write",
      "deniedActions": [
        "storage.write"
      ],
      "fixtureFiles": [],
      "httpRouteFiles": [
        "tests/fixtures/pr-radar.github.http-routes.json"
