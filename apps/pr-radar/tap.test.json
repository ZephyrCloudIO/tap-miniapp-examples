{
  "$schema": "https://the-ai-platform.dev/schemas/tap.test.schema.json",
  "schemaVersion": 2,
  "packageId": "github-notify",
  "configPath": "rstest.tap.config.ts",
  "profiles": {
    "pr-radar-desktop": {
      "surface": "github-notify-dashboard",
      "target": "desktop",
      "mode": "surface",
      "permissionScenario": "default",
      "deniedActions": [],
      "fixtureFiles": [],
      "httpRouteFiles": [],
      "requiredOrigins": [
        "https://api.github.com"
      ],
      "requiredEffects": [
        "effect:external-network:https://api.github.com",
        "effect:credentials:github",
        "effect:credentials:http",
        "effect:storage:github-notify",
        "effect:external-navigation:https://github.com"
      ],
      "nativeServices": false,
      "credentialSlots": [],
      "environment": {
        "viewport": {
          "width": 1280,
          "height": 720
        },
        "locale": "en-US",
        "timezone": "UTC",
        "theme": "light",
        "reducedMotion": true,
        "seed": 1,
        "fixedNow": "2026-01-01T00:00:00Z"
      },
      "artifacts": {
        "trace": "failure-only",
        "screenshots": "always"
      }
    },
    "pr-radar-desktop-network-denied": {
      "surface": "github-notify-dashboard",
      "target": "desktop",
      "mode": "surface",
      "nativeServices": false,
      "credentialSlots": [],
