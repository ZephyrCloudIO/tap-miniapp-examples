        "trace": "failure-only",
        "screenshots": "failure-only"
      },
      "permissionScenario": "http-denied",
      "deniedActions": [
        "network.request"
      ],
      "fixtureFiles": [],
      "httpRouteFiles": [
        "tests/fixtures/pr-radar.github.http-routes.json"
      ],
      "requiredOrigins": [],
      "requiredEffects": [
        "effect:external-network:https://api.github.com"
      ],
      "environment": {
        "viewport": {
          "width": 1280,
          "height": 720
        },
        "locale": "en-US",
        "timezone": "UTC",
        "theme": "dark",
        "reducedMotion": true,
        "seed": 2,
        "fixedNow": "2026-01-01T00:00:00Z"
      }
    },
    "pr-radar-desktop-credentials-use-denied": {
      "surface": "github-notify-dashboard",
