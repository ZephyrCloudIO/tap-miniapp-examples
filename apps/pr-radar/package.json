{
  "name": "@tap-examples/pr-radar",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "type": "module",
  "scripts": {
    "dev": "rslib build --watch",
    "build": "tap-miniapp build",
    "publish": "tap-miniapp publish",
    "build:target": "rslib build",
    "typecheck": "tsc --noEmit",
    "typecheck:tap": "tsc --project ./tsconfig.tap-test.json --noEmit",
    "test:tap": "rstest run --config ./rstest.tap.config.ts",
    "test:tap:list": "rstest list --config ./rstest.tap.config.ts",
    "validate:manifest": "tap-miniapp check",
    "verify:package": "tap-miniapp check"
  },
  "dependencies": {
    "@theaiplatform/miniapp-sdk": "0.19.0"
  },
  "devDependencies": {
    "@module-federation/rsbuild-plugin": "2.8.1",
    "@rsbuild/core": "^2.1.5",
    "@rslib/core": "^0.23.2",
    "@rstest/core": "0.11.5",
    "@rstest/playwright": "0.11.5",
    "@types/node": "^24.0.0",
    "playwright": "^1.61.0",
    "typescript": "^6.0.3"
  }
}
