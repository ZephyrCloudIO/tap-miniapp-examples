{
  "$schema": "./node_modules/@theaiplatform/miniapp-sdk/config-schema.json",
  "buildSchemaVersion": 2,
  "versionLabel": "0.3.0",
  "presentation": {
    "name": "TAP Email",
    "slug": "tap-email",
    "description": "Keyboard-first unified email with coverage-aware Operational Zero.",
    "categories": [
      "communication",
      "productivity"
    ],
    "iconAssets": [
      "assets/tap-email.svg"
    ],
    "assets": [
      {
        "role": "app-icon",
        "mediaType": "image/svg+xml",
        "path": "assets/tap-email.svg",
        "integrity": "pending",
        "sizes": [
          "any"
        ],
        "theme": "any"
      }
    ]
  },
  "compatibility": {
    "tapSdk": "0.19.0",
    "tapHost": ">=2.24.0"
  },
  "targets": {
    "desktop": {
      "remoteName": "tap_email_desktop",
      "remoteEntry": "remoteEntry.mjs",
      "remoteEntryIntegrity": "pending",
      "manifest": "mf-manifest.json",
      "manifestIntegrity": "pending",
      "assetLock": "tap.package.lock.json",
      "assetLockIntegrity": "pending",
      "libraryType": "module",
      "exposes": {
        "./tap/lifecycle": {
          "integrity": "pending",
          "runtime": "webview"
        },
        "./ui/desktop": {
          "integrity": "pending",
          "runtime": "webview"
        }
      }
    },
    "quickjs": {
      "remoteName": "tap_email_quickjs",
      "remoteEntry": "remoteEntry.mjs",
      "remoteEntryIntegrity": "pending",
      "manifest": "mf-manifest.json",
      "manifestIntegrity": "pending",
      "assetLock": "tap.package.lock.json",
      "assetLockIntegrity": "pending",
      "libraryType": "module",
      "exposes": {
        "./mcp/tap-email-mcp": {
          "integrity": "pending",
          "runtime": "quickjs"
        },
        "./activity/tap-email-committed-actions": {
          "integrity": "pending",
          "runtime": "quickjs"
        }
      }
    }
  },
