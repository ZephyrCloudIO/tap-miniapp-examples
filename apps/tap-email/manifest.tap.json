        "effects": [
          {
            "kind": "external-network",
            "resources": [
              "https://tap-email-coordinator.theaiplatform.app"
            ]
          },
          {
            "kind": "credentials",
            "resources": [
              "http"
            ]
          }
        ]
      },
      "lifecycleScope": "contribution",
      "options": {
        "protocolVersion": "2025-11-25",
        "implementation": {
          "type": "streamable-http",
          "url": "https://tap-email-coordinator.theaiplatform.app/mcp",
          "authentication": "header-credentials",
          "credentialRequirements": [
            {
              "id": "tap-email-access-token",
              "header": "X-TAP-Email-MCP-Token"
            }
          ]
        },
        "consumerPolicy": {
          "contributionIds": [
            "tap-email-specialist"
          ],
          "externalConsumers": [
            "selected-specialists",
            "chat",
            "platform"
          ]
        }
      }
