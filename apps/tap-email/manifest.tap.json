      "kind": "mcp.server",
      "id": "tap-email-live-mcp",
      "apiVersion": 1,
      "targets": {
        "desktop": {
          "runtime": "host-declarative"
        }
      },
      "authorization": {
        "allOf": [
          "tap-email.view"
