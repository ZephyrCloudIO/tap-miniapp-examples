    {
      "kind": "ui.surface",
      "id": "tap-email",
      "apiVersion": 1,
      "targets": {
        "desktop": {
          "expose": "./ui/desktop",
          "runtime": "webview"
        }
      },
      "publishes": [
        "tap-email.surface.mounted",
        "tap-email.surface.unmounted",
        "tap-email.context.changed"
      ],
      "authorization": {
        "allOf": [
          "tap-email.view"
        ],
        "onDemand": [
          "tap-email.manage",
          "network.request",
          "credentials.use",
          "storage.profile.files.read",
          "storage.profile.files.write",
          "storage.profile.sqlite",
          "storage.profile.zvec",
          "embeddings.models.read",
          "embeddings.compute",
          "chat.compose",
          "task.write",
          "artifacts.read",
          "channels.list",
          "channels.create",
          "channels.send-message",
          "notifications.show",
          "navigation.open-external",
          "files.pick-open",
          "files.read",
          "files.pick-save",
          "files.overwrite",
          "workflows.list",
          "workflows.invoke",
          "workflows.runs.read"
        ],
        "effects": [
          {
            "kind": "storage",
            "resources": [
              "tap-email"
            ]
          },
          {
            "kind": "external-network",
            "resources": [
              "https://tap-email-coordinator.theaiplatform.app"
            ]
          },
          {
            "kind": "credentials",
            "resources": [
              "http"
            ]
          },
          {
            "kind": "external-navigation",
            "resources": [
              "https://accounts.google.com"
            ]
          },
          {
            "kind": "host-api",
            "resources": [
              "tap.channels:create",
              "tap.channels:list",
              "tap.channels:send-message",
              "tap.chat:send-text",
              "tap.workflows:list",
              "tap.workflows:invoke",
              "tap.workflow-runs:read"
            ]
          },
          {
            "kind": "user-notification",
            "resources": [
              "os"
            ]
          },
          {
            "kind": "user-file",
            "resources": [
              "pick-open",
              "read",
              "pick-save",
              "overwrite"
            ]
          }
        ]
      },
      "lifecycleScope": "mount",
      "options": {
        "displayName": "TAP Email",
        "description": "Triage every connected email account from one keyboard-first panel.",
        "placement": "workspace-left",
        "scope": "workspace",
        "instancePolicy": "per-workspace",
        "persistence": "retained",
        "iconAssets": [
          "assets/tap-email.svg"
        ]
      }
    },
    {
      "kind": "action.command",
      "id": "tap-email-email-this",
      "apiVersion": 1,
      "targets": {
        "desktop": {
          "runtime": "host-declarative"
        }
      },
      "authorization": {
        "allOf": [
          "artifacts.read"
        ]
      },
      "lifecycleScope": "installation",
      "options": {
        "label": "Email this\u2026",
        "description": "Resolve this TAP item into a new email draft for review.",
        "contexts": [
          "channel-message",
          "pull-request",
          "task",
          "repository-issue"
        ],
        "launch": {
          "kind": "ui.surface",
          "contributionId": "tap-email"
        }
      }
    },
    {
      "kind": "specialist",
      "id": "tap-email-specialist",
      "apiVersion": 1,
      "targets": {
        "desktop": {
          "runtime": "host-declarative"
        }
      },
      "authorization": {
        "allOf": [
          "tap-email.specialist",
          "tap-email.view"
        ]
      },
      "lifecycleScope": "installation",
      "options": {
        "manifest": "specialists/tap-email-specialist/0.3.0.json"
      }
    },
    {
      "kind": "mcp.server",
      "id": "tap-email-mcp",
      "apiVersion": 1,
      "targets": {
        "quickjs": {
          "expose": "./mcp/tap-email-mcp",
          "runtime": "quickjs"
        }
      },
      "authorization": {
        "allOf": [
          "tap-email.view"
        ],
        "effects": [
          {
            "kind": "storage",
            "resources": [
              "tap-email"
            ]
          }
        ]
      },
      "lifecycleScope": "contribution",
      "options": {
        "protocolVersion": "2025-11-25",
        "implementation": {
          "type": "package-runtime"
        },
        "consumerPolicy": {
          "contributionIds": [
            "tap-email-specialist"
          ],
          "externalConsumers": [
            "selected-specialists",
            "chat",
            "platform"
          ]
        }
      }
    },
    {
      "kind": "mcp.tool",
      "id": "tap-email-mailbox-summary",
      "apiVersion": 1,
      "authorization": {
        "allOf": [
          "tap-email.view"
        ],
        "effects": [
          {
            "kind": "storage",
            "resources": [
              "tap-email"
            ]
          }
        ]
      },
      "lifecycleScope": "contribution",
      "options": {
        "serverContributionId": "tap-email-mcp",
        "toolName": "get_mailbox_summary",
        "timeoutMs": 1000,
        "effects": [
          {
            "kind": "storage",
            "resources": [
              "tap-email"
            ]
          }
        ],
        "storageReads": [
          {
            "namespace": "tap-email",
            "keyTemplate": "operational/v1"
          }
        ]
      }
    },
    {
      "kind": "mcp.tool",
      "id": "tap-email-active-context",
      "apiVersion": 1,
      "authorization": {
        "allOf": [
          "tap-email.view"
        ],
        "effects": [
          {
            "kind": "storage",
            "resources": [
              "tap-email"
            ]
          }
        ]
      },
      "lifecycleScope": "contribution",
      "options": {
        "serverContributionId": "tap-email-mcp",
        "toolName": "get_active_email_context",
        "timeoutMs": 1000,
        "effects": [
          {
            "kind": "storage",
            "resources": [
              "tap-email"
            ]
          }
        ],
        "storageReads": [
          {
            "namespace": "tap-email",
            "keyTemplate": "operational/v1"
          }
        ]
      }
    },
    {
      "kind": "mcp.tool",
      "id": "tap-email-activity-summary",
      "apiVersion": 1,
      "authorization": {
        "allOf": [
          "tap-email.view"
        ],
        "effects": [
          {
            "kind": "storage",
            "resources": [
              "tap-email"
            ]
          }
        ]
      },
      "lifecycleScope": "contribution",
      "options": {
        "serverContributionId": "tap-email-mcp",
        "toolName": "get_email_activity_summary",
        "timeoutMs": 1000,
        "effects": [
          {
            "kind": "storage",
            "resources": [
              "tap-email"
            ]
          }
        ],
        "storageReads": [
          {
            "namespace": "tap-email",
            "keyTemplate": "users/{userId}/activity/v1"
          }
        ]
      }
    },
    {
      "kind": "agent.skill",
      "id": "email-operations",
      "apiVersion": 1,
      "targets": {
        "desktop": {
          "runtime": "host-declarative"
        }
      },
      "authorization": {
        "allOf": [
          "tap-email.view"
        ]
      },
      "lifecycleScope": "installation",
      "options": {
        "files": [
          "SKILL.md"
        ]
      }
    },
    {
      "kind": "miniapp",
      "id": "tap-email-app",
      "apiVersion": 1,
      "options": {
        "contributionIds": [
          "tap-email",
          "tap-email-specialist",
          "tap-email-mcp",
          "tap-email-mailbox-summary",
          "tap-email-active-context",
          "tap-email-activity-summary",
          "tap-email-email-this",
          "email-operations",
          "tap-email-committed-actions",
          "tap-email-live-mcp",
          "tap-email-list-accounts",
