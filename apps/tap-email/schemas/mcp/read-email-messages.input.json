{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "mailId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:@/-]{0,255}$"
    }
  },
  "type": "object",
  "properties": {
    "accountId": { "$ref": "#/$defs/mailId" },
    "threadId": { "$ref": "#/$defs/mailId" },
    "messageIds": {
      "type": "array",
      "items": { "$ref": "#/$defs/mailId" },
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true
    },
    "maximumCharactersPerMessage": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20000,
      "default": 8000
    }
  },
  "required": ["accountId", "threadId", "messageIds"],
  "additionalProperties": false
}
