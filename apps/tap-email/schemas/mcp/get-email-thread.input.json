{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "mailId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:@/-]{0,255}$"
    }
  },
  "type": "object",
  "properties": {
    "accountId": { "$ref": "#/$defs/mailId" },
    "threadId": { "$ref": "#/$defs/mailId" }
  },
  "required": ["accountId", "threadId"],
  "additionalProperties": false
}
