{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "mailId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:@/-]{0,255}$"
    }
  },
  "type": "object",
  "properties": {
    "accountId": {
      "$ref": "#/$defs/mailId"
    },
    "threadId": {
      "$ref": "#/$defs/mailId"
    },
    "cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    }
  },
  "required": [
    "accountId",
    "threadId"
  ],
  "additionalProperties": false
}
