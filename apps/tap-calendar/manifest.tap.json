      ],
      "subscribes": [
        "tap-pkg.examples-tap-calendar.calendar.changed"
      ],
      "authorization": {
        "allOf": ["calendar.view"],
        "onDemand": [
          "calendar.manage",
          "calendar.approve",
          "calendar.publish",
          "credentials.use",
          "network.request",
          "notifications.show",
          "channels.create",
          "channels.list",
          "channels.read",
          "channels.send-message",
          "task.read",
          "workflows.list",
          "workflows.invoke",
          "navigation.open-external"
        ],
        "effects": [
          { "kind": "storage", "resources": ["tap-calendar"] },
          {
            "kind": "external-network",
            "resources": [
              "http://127.0.0.1:8787",
              "https://calendar-api.theaiplatform.app"
            ]
          },
          {
            "kind": "external-navigation",
            "resources": [
              "https://accounts.google.com",
              "https://login.microsoftonline.com",
              "https://zoom.us"
            ]
          },
          { "kind": "credentials", "resources": ["http"] },
          { "kind": "user-notification", "resources": ["os"] },
          {
            "kind": "host-api",
            "resources": [
              "tap.channels:create",
              "tap.channels:list",
              "tap.channels:read",
              "tap.channels:send-message",
              "tap.workflows:list",
              "tap.workflows:invoke"
            ]
          }
        ]
      },
      "lifecycleScope": "mount",
      "options": {
        "displayName": "TAP Calendar",
        "description": "Plan time, coordinate participants, and manage scheduling inside TAP.",
        "placement": "workspace-left",
        "scope": "workspace",
        "instancePolicy": "per-workspace",
        "persistence": "retained",
        "iconAssets": ["assets/calendar.svg"]
