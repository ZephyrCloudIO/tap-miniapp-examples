{
  "name": "@tap-examples/tap-calendar",
  "version": "0.2.1",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "type": "module",
  "scripts": {
    "dev": "rsbuild dev",
    "preview": "rsbuild preview",
    "build": "pnpm build:preview && pnpm build:miniapp",
    "publish": "tap-miniapp publish",
    "publish:production": "node scripts/verify-production-analytics.mjs dist && tap-miniapp publish --from dist",
    "verify:production": "node scripts/verify-production-analytics.mjs dist",
    "test:release": "node --test scripts/verify-production-analytics.test.mjs",
    "build:watch": "rslib build --watch",
    "build:watch:local": "TAP_CALENDAR_GATEWAY_URL=http://127.0.0.1:8787 rslib build --watch",
    "build:preview": "rsbuild build",
    "build:target": "pnpm check:mcp-timezones && rslib build",
    "build:miniapp": "tap-miniapp build",
    "build:miniapp:production": "TAP_CALENDAR_GATEWAY_URL=https://calendar-api.theaiplatform.app pnpm build:miniapp",
    "build:miniapp:local": "TAP_CALENDAR_GATEWAY_URL=http://127.0.0.1:8787 pnpm build:miniapp",
    "generate:mcp-timezones": "node scripts/generate-mcp-time-zone-data.mjs",
    "check:mcp-timezones": "node scripts/generate-mcp-time-zone-data.mjs --check",
    "typecheck": "tsc --noEmit",
    "typecheck:tap": "tsc --project ./tsconfig.tap-test.json --noEmit",
    "test": "rstest run",
    "test:tap": "rstest run --config ./rstest.tap.config.ts",
    "test:tap:list": "rstest list --config ./rstest.tap.config.ts",
    "validate:manifest": "tap-miniapp check",
    "verify:package": "tap-miniapp check"
  },
  "dependencies": {
    "@vvo/tzdb": "6.198.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "timezone-support": "3.1.0",
    "@theaiplatform/miniapp-sdk": "0.16.0"
  },
  "devDependencies": {
    "@module-federation/rsbuild-plugin": "2.8.1",
    "@rsbuild/core": "^2.1.5",
    "@rsbuild/plugin-react": "2.1.0",
    "@rslib/core": "^0.23.2",
    "@rstest/core": "0.11.5",
    "@rstest/playwright": "0.11.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "moment-timezone": "0.6.3",
    "playwright": "^1.61.0",
    "typescript": "^6.0.3"
  }
}
